PREFIX wdt: <http://www.wikidata.org/prop/direct/>

# The VALUES block below is injected at runtime with the Wikidata IRIs
# mapped from GraphDB's local entities (see enrich_wikidata_monuments.py).
SELECT ?wikidataUri ?cultId ?herisId WHERE {
    VALUES ?wikidataUri {
__VALUES__
    }
    OPTIONAL { ?wikidataUri wdt:P2951 ?cultId } .  # Cultural heritage database ID
    OPTIONAL { ?wikidataUri wdt:P9154 ?herisId } .  # Heritage Information System ID
}
