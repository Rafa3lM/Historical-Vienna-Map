PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX schema: <https://schema.org/>
PREFIX property: <http://www.geschichtewiki.wien.gv.at/Special:URIResolver/Property-3A>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

INSERT {
    ?entity property:WikidataCulturalHeritageID ?cultId .
    ?entity property:WikidataHERISID ?herisId .
}
WHERE {
    # Get entities with Wikidata links (only buildings or topographical objects can be monuments)
    { ?entity property:Art_des_Bauwerks ?buildingType }
    UNION
    { ?entity property:Art_des_Objekts ?objectType }
    ?entity skos:exactMatch ?wikidataUri .

    # Filter to only Wikidata URIs
    FILTER(STRSTARTS(STR(?wikidataUri), "http://www.wikidata.org/entity/"))

    # Query Wikidata for heritage IDs
    SERVICE <https://query.wikidata.org/sparql> {
        OPTIONAL { ?wikidataUri wdt:P2951 ?cultId }.  # Cultural heritage database ID
        OPTIONAL { ?wikidataUri wdt:P9154 ?herisId } .  # Heritage Information System ID
    }

    # No duplicates
    FILTER NOT EXISTS { ?entity property:WikidataCulturalHeritageID ?existing }
}